rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // True when the signed-in student has an enrollment doc under the given tutor.
    function isEnrolledWith(tutorUid) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/enrollment/$(tutorUid));
    }

    // ── Health probe ───────────────────────────────────────────────────────

    match /__health/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Usernames (username → uid lookup) ──────────────────────────────────

    match /usernames/{usernameKey} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'username', 'createdAt'])
        && !exists(/databases/$(database)/documents/usernames/$(usernameKey));
      allow update, delete: if false;
    }

    // ── User documents ─────────────────────────────────────────────────────

    match /users/{uid} {
      // Any signed-in user can read another's profile (needed for tutor name
      // resolution in join_request accept flow and enrollment resolver).
      allow read: if signedIn();
      allow create, update, delete: if isUser(uid);

      // ── sessions ──────────────────────────────────────────────────────
      match /sessions/{sessionId} {
        allow read, write: if isUser(uid);
        // Enrolled student reads sessions where they are the client.
        allow read: if isEnrolledWith(uid)
          && resource.data.clientId == request.auth.uid;
      }

      match /deleted_sessions/{sessionId} {
        allow read, write: if isUser(uid);
      }

      // ── clients ────────────────────────────────────────────────────────
      match /clients/{clientId} {
        allow read, write: if isUser(uid);
        // Enrolled student reads their own profile doc in the tutor's roster.
        allow read: if isEnrolledWith(uid)
          && clientId == request.auth.uid;
      }

      match /deleted_clients/{clientId} {
        allow read, write: if isUser(uid);
      }

      // ── enrollment ─────────────────────────────────────────────────────
      // Written by:
      //   a) The TUTOR when they accept a join request (tutorId == doc key).
      //   b) The STUDENT themselves via the email/phone fallback self-enroll.
      match /enrollment/{tutorId} {
        allow read: if isUser(uid);
        allow create, update: if signedIn() && request.auth.uid == tutorId;
        allow create, update: if isUser(uid);
        allow delete: if false;
      }

      // ── settings ──────────────────────────────────────────────────────
      match /settings/{docId} {
        allow read, write: if isUser(uid);
      }

      // ── fcmTokens ─────────────────────────────────────────────────────
      match /fcmTokens/{tokenId} {
        allow read, write: if isUser(uid);
      }

      // ── notifications ─────────────────────────────────────────────────
      match /notifications/{notifId} {
        allow read, write: if isUser(uid);
      }

      // ── Catch-all for any future sub-collections ───────────────────────
      match /{subcollection}/{docId} {
        allow read, write: if isUser(uid);
      }
    }

    // ── Collection-group: clients ──────────────────────────────────────────
    // StudentEnrollmentResolver queries collectionGroup('clients') by email
    // or phone to find an orphan client record (pre-QR manual add by tutor).
    match /{path=**}/clients/{clientId} {
      allow read: if signedIn();
    }

    // ── Join requests ──────────────────────────────────────────────────────

    match /join_requests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.clientFirebaseUid == request.auth.uid
        && request.resource.data.status == 'pending';

      allow read: if signedIn()
        && (
          resource.data.clientFirebaseUid == request.auth.uid
          || resource.data.tutorId == request.auth.uid
        );

      // Tutor resolves (accept/reject) — only status + resolvedAt may change.
      allow update: if signedIn()
        && resource.data.tutorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'resolvedAt']);

      // Student marks their own pending request as 'expired'.
      allow update: if signedIn()
        && resource.data.clientFirebaseUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'expired'
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'resolvedAt']);

      allow delete: if false;
    }
  }
}
